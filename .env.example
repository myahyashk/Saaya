# Saaya — environment variables

# Backend URL used by the Vite /api proxy, or by the browser in direct mode.
# Use a LAN IP (for example http://192.168.1.20:8000) from another device.
VITE_API_BASE_URL=http://localhost:8000

# true routes browser requests through Vite at /api to avoid development CORS.
# Set false to call VITE_API_BASE_URL directly (the backend must allow CORS).
VITE_API_USE_PROXY=true

# Set true to use local mock data; set false to request the real API.
# This value must be the literal string "true" to enable mock data.
VITE_USE_MOCK=true

# Set to "true" to show the "Demo: simulate extreme heat day" toggle in the sidebar
# This adds scenario=extreme to API requests (or loads extreme mock data)
VITE_DEMO=true
