# Saaya — environment variables

# Base URL for the backend API (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to use local mock data instead of the real API
# The app works end-to-end with mock data — no backend required
VITE_USE_MOCK=true

# Set to "true" to show the "Demo: simulate extreme heat day" toggle in the sidebar
# This adds scenario=extreme to API requests (or loads extreme mock data)
VITE_DEMO=true
